.DEFAULT_GOAL := help

.PHONY: help usage all upgrade update force-update check get install clean backup
.PHONY: stop start annotate check-supported

help: ## Show available targets
	$(info -----------------------------------------)
	$(info Make Targets)
	$(info -----------------------------------------)
	$(QUIET) awk '/^[a-zA-Z._0-9%-]+:/ {             \
	  nb = sub(/^## /, "", helpMsg);                  \
	  if (nb == 0) {                                  \
	    helpMsg = $$0;                                \
	    nb = sub(/^[^:]*:.* ## /, "", helpMsg);      \
	  }                                               \
	  if (nb) {                                       \
	    print $$1 "\t" helpMsg;                       \
	  }                                               \
	}                                                 \
	{ helpMsg = $$0 }'                                \
	$(MAKEFILE_LIST) | column -ts:

usage: help

all: update ## Download, install, and restart Zoom

upgrade: update ## Alias for update

# Sets shell variables latest, installed, and current (yes when installed >= latest).
VERSION_PROBE = latest="$$($(LATEST_VERSION_COMMAND))";                     \
	installed="$$($(INSTALLED_VERSION_COMMAND))" || installed="";             \
	current=no;                                                              \
	if [ -n "$$latest" ] && [ -n "$$installed" ] &&                          \
	   [ "$$(printf '%s\n%s\n' "$$latest" "$$installed" | sort -V | tail -n1)" = "$$installed" ]; then \
	  current=yes;                                                           \
	fi

update: check-supported ## Update Zoom only when a newer version is available
	$(QUIET) $(VERSION_PROBE);                                                \
	if [ "$$current" = yes ]; then                                           \
	  printf "Zoom %s is already the latest version. Nothing to do.\n" "$$installed"; \
	else                                                                     \
	  if [ -z "$$latest" ]; then                                             \
	    printf "Could not determine the latest Zoom version; updating anyway.\n"; \
	  else                                                                   \
	    printf "Updating Zoom %s -> %s\n" "$${installed:-(not installed)}" "$$latest"; \
	  fi;                                                                    \
	  $(MAKE) --no-print-directory force-update;                             \
	fi

force-update: get stop install start ## Reinstall Zoom and restart the application

check: check-supported ## Show installed and latest available Zoom versions
	$(QUIET) $(VERSION_PROBE);                                                \
	printf "Installed : %s\n" "$${installed:-(not installed)}";              \
	printf "Latest    : %s\n" "$${latest:-(unknown)}";                        \
	if [ "$$current" = yes ]; then                                           \
	  printf "Zoom is up to date.\n";                                        \
	else                                                                     \
	  printf "An update is available. Run 'make update'.\n";                 \
	fi

get: check-supported backup $(SRC_NAME) ## Backup existing package and download latest package

$(SRC_NAME): ## Download latest Zoom package for the current OS family
	$(QUIET) "$(WGET)" -c "$(SRC_URL)"

install: check-supported get ## Install the downloaded Zoom package
	$(QUIET) $(INSTALL_COMMAND)

clean: ## Remove the current downloaded Zoom package
	$(QUIET) rm -f "$(SRC_NAME)"

stop: ## Stop a running Zoom process
	$(QUIET)-"$(PKILL)" -e zoom

start: ## Start Zoom in the background
	$(QUIET) "$(ZOOM)" &

backup: check-supported ## Rename an existing package with its embedded version
ifneq (,$(wildcard $(SRC_NAME)))
ifeq ($(OS_PACKAGE_TYPE),deb)
	$(QUIET) mv "$(SRC_NAME)" "$(SRC_NAME)_v$$(dpkg-deb -W "$(SRC_NAME)" | cut -f2)"
else ifeq ($(OS_PACKAGE_TYPE),rpm)
	$(QUIET) mv "$(SRC_NAME)" "$(SRC_NAME)_v$$(rpm -qp --queryformat "%{VERSION}" "$(SRC_NAME)" 2>/dev/null)"
endif
endif

annotate: ## Start xcompmgr to avoid black screen while annotating
	$(QUIET) "$(XCOMPMGR)" -c -l0 -t0 -r -o.00 &

check-supported:
ifeq ($(OS_PACKAGE_TYPE),unsupported)
	$(error Unsupported OS package family: OS_ID=$(OS_ID), OS_ID_LIKE=$(OS_ID_LIKE))
endif

FORCE:
